# Gradlly marketing site (apps/main)
#
# Copy to .env.local for development. Every value below is public: they are all
# NEXT_PUBLIC_, so they are compiled into the browser bundle. Nothing secret
# belongs in this file.

# ── Canonical origin ─────────────────────────────────────────────────────────
# Used for canonical URLs, Open Graph URLs, the sitemap and robots.txt.
#
# Production is https://gradlly.co.uk
#   Source: `vercel alias ls`, 2026-10-20, which maps the production deployment
#   of @gradlly/main to both gradlly.co.uk and www.gradlly.co.uk.
#
# Recorded here rather than hardcoded because the domain appears in no other
# file in this repository, so code asserting it would be an unverifiable claim.
# If this is unset, canonicals fall back to http://localhost:3005 rather than
# guessing production: a canonical pointing at a real host that is wrong is
# worse than one pointing nowhere.
NEXT_PUBLIC_SITE_URL=http://localhost:3005

# ── Portal sign-in ───────────────────────────────────────────────────────────
# Origins only, with no trailing slash and no path. "/login" is appended, which
# is the sign-in route in all four portals.
#
# A portal whose variable is unset is not rendered in the sign-in list at all,
# rather than rendered as a link to nowhere.
NEXT_PUBLIC_EMPLOYER_URL=http://localhost:3002
NEXT_PUBLIC_PROVIDER_URL=http://localhost:3004
NEXT_PUBLIC_APPRENTICE_URL=http://localhost:3001
NEXT_PUBLIC_FLOW_URL=http://localhost:3003

# ── Analytics ────────────────────────────────────────────────────────────────
# Cookieless only, and off unless this is exactly "true". Off in this file on
# purpose: a measurement tool should be switched on by a decision, not by a
# default nobody noticed.
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# ── Demo requests ────────────────────────────────────────────────────────────
# Server-side only, so no NEXT_PUBLIC_ prefix. Where a demo request is sent.
# Unset means the request is logged server-side and not emailed, which is the
# behaviour to expect until the email provider is configured: the API's email
# module defaults to its noop sender.
DEMO_REQUEST_TO_EMAIL=
